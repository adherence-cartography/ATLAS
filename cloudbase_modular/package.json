{
  "name": "atlas-platform",
  "version": "8.7.0",
  "description": "ATLAS Adherence Cartography Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "vite build && node scripts/build.js",
    "build:preview": "vite preview",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy --config wrangler.prod.toml"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@playwright/test": "^1.44.0",
    "wrangler": "^3.57.0",
    "vite": "^5.2.0"
  }
}
