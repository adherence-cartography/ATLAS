{
  "rules": {

    "assessments": {
      ".indexOn": ["patient_number", "user_id", "timestamp", "campaign_id", "partner_key", "patient_ref", "study_id"]
    },

    "peacs_assessments": {
      ".indexOn": ["patient_number", "partner_key", "patient_ref"]
    },

    "partner_keys": {
      ".indexOn": ["active"]
    },

    "partner_usage": {
      "$partner": {
        ".indexOn": [".key"]
      }
    },

    "mapData": {
      ".indexOn": ["timestamp"]
    },

    "wad_checkins": {
      ".indexOn": ["timestamp"]
    },

    "ws_audit": {
      "$workspace": {
        ".indexOn": ["ts"]
      }
    },

    "wall_projects": {
      ".indexOn": ["created_at"]
    },

    "campaigns": {
      ".indexOn": ["created_at"]
    }

  }
}
